#include "../includes/libft.h"

char	*ft_strtrim(char *str, char c)
{
	char	*sc;
	int		i;
	int		temp;
	int		len;

	i = 0;
	len = 0;
	while (str[i] && str[i] == c)
		i++;
	temp = i;
	while (str[i] && str[i++] != c)
		len++;
	sc = malloc(sizeof(char) * (len + 1));
	while (str[temp] && str[temp] != c)
	{
		sc[temp] = str[temp];
		temp++;
	}
	sc[temp] = 0;
	return (sc);
}
